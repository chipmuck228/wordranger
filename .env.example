# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Curated placement review persistence. Unset or `supabase` uses the
# service-role store. `file` is local/internal tooling only and must be
# set explicitly; production must not silently fall back to the JSON file.
# PLACEMENT_REVIEW_STORE=file
#
# Write gate for /debug/vocabulary-placement. Default is disabled. Hiding
# the debug route is not authorization. Enable only on protected
# local/internal or Preview deployments.
# PLACEMENT_REVIEW_WRITE_ENABLED=1

# Shared student-game runtime fixture. Production must leave both unset so
# Ranger Trial, Word Bubble, Matching, and Snake use durable Supabase
# adapters (fail closed if Supabase env is missing). Never set these on
# Vercel production.
#
# `npm run dev` uses this file as-is. The code default is Supabase; memory
# mode is opt-in. Playwright e2e sets RANGER_TRIAL_RUNTIME=memory itself.
#
# RANGER_TRIAL_RUNTIME=memory
# GAME_RUNTIME=memory is a backward-compatible alias for the same fixture.

# Internal Contextual Learning Context Lab at /play/context-lab.
# Default is disabled. Production must leave this unset. Do not expose a
# NEXT_PUBLIC_ copy. This flag is not a Ranger Trial / game runtime switch.
# CONTEXT_LAB_ENABLED=1



