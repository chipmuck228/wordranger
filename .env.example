# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Explicit local/e2e Ranger Trial fixture. Production must leave this unset
# so student-facing routes use durable Supabase adapters (fail closed if
# Supabase env is missing). Never set this on Vercel production.
# RANGER_TRIAL_RUNTIME=memory


