# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Curated placement review persistence. Unset or `supabase` uses the
# service-role store. `file` is local/internal tooling only and must be
# set explicitly; production must not silently fall back to the JSON file.
# PLACEMENT_REVIEW_STORE=file
#
# Write gate for /debug/vocabulary-placement. Default is disabled. Hiding
# the debug route is not authorization. Enable only on protected
# local/internal or Preview deployments.
# PLACEMENT_REVIEW_WRITE_ENABLED=1

# Shared student-game runtime fixture. Production must leave both unset so
# Ranger Trial, Word Bubble, Matching, and Snake use durable Supabase
# adapters (fail closed if Supabase env is missing). Never set these on
# Vercel production.
#
# `npm run dev` uses this file as-is. The code default is Supabase; memory
# mode is opt-in. Playwright e2e sets RANGER_TRIAL_RUNTIME=memory itself.
#
# RANGER_TRIAL_RUNTIME=memory
# GAME_RUNTIME=memory is a backward-compatible alias for the same fixture.

# Internal Contextual Learning Context Lab at /play/context-lab.
# Default is disabled. Production must leave CONTEXT_LAB_ENABLED unset.
# Do not expose a NEXT_PUBLIC_ copy. This flag is not a Ranger Trial /
# game runtime switch.
# CONTEXT_LAB_ENABLED=1
#
# Explicit repository selector. Required when the route is enabled.
# Use memory only for local development, unit/component tests, and
# Playwright. Deployed production/preview must use supabase and must
# not fall back to memory. Do not reuse GAME_RUNTIME or
# RANGER_TRIAL_RUNTIME.
# CONTEXT_LAB_RUNTIME=memory
# CONTEXT_LAB_RUNTIME=supabase
#
# Playwright-only memory probe. Leave these unset in ordinary development
# and every deployed environment. Default is 404.
# CONTEXT_LAB_E2E=1
# CONTEXT_LAB_E2E_PROBE_ENABLED=1

# Internal Debug Tools in Homepage Settings. Default is disabled.
# Production and Vercel preview stay closed even if the flag is set.
# DEBUG_TOOLS_ENABLED=1
#
# Contextual content review routes. Default is 404.
# CONTEXTUAL_CONTENT_REVIEW_ENABLED=1
#
# Local write gate for human review records. Never enable on Vercel
# production/preview. Hiding the Settings group is not authorization.
# CONTEXTUAL_CONTENT_REVIEW_WRITE_ENABLED=1

# Contextual content release dry-run routes. Default is 404.
# CONTEXTUAL_CONTENT_RELEASE_ENABLED=1
#
# Local write gate for release drafts/preflight. Never enable on Vercel
# production/preview. This is not publication and does not switch Context Lab.
# CONTEXTUAL_CONTENT_RELEASE_WRITE_ENABLED=1
#
# Explicit release-repository selector. Required when the route is enabled.
# Do not reuse CONTEXT_LAB_RUNTIME or GAME_RUNTIME. No silent fallback.
# memory is local/e2e only. file is local development only.
# CONTEXTUAL_RELEASE_RUNTIME=memory
# CONTEXTUAL_RELEASE_RUNTIME=file

# Contextual content batch promotion. Independent of review and release.
# Default is disabled. Hiding the Review UI is not authorization.
# CONTEXTUAL_CONTENT_PROMOTION_ENABLED=1
#
# Local write gate for Promote reviewed batch. Requires promotion
# enabled. Never inherits CONTEXTUAL_CONTENT_REVIEW_WRITE_ENABLED.
# Never enable on Vercel production/preview.
# CONTEXTUAL_CONTENT_PROMOTION_WRITE_ENABLED=1
#
# Explicit promotion-repository selector. Required when promotion is
# enabled. Do not reuse CONTEXTUAL_RELEASE_RUNTIME, CONTEXT_LAB_RUNTIME,
# or review flags. Missing or invalid values fail closed. No silent
# file fallback. memory is local/unit/e2e only. file is local
# development / local human review only. supabase uses the existing
# server service-role client and does not fall back to file or memory.
# Vercel production/preview must not use memory or file.
# This task does not apply the remote promotion migration.
#
# Local file:
# CONTEXTUAL_CONTENT_PROMOTION_ENABLED=1
# CONTEXTUAL_CONTENT_PROMOTION_WRITE_ENABLED=1
# CONTEXTUAL_PROMOTION_RUNTIME=file
#
# Tests / Playwright memory:
# CONTEXTUAL_CONTENT_PROMOTION_ENABLED=1
# CONTEXTUAL_CONTENT_PROMOTION_WRITE_ENABLED=1
# CONTEXTUAL_PROMOTION_RUNTIME=memory
#
# Supabase (after applying supabase/migrations/202609220003_contextual_content_batch_promotions.sql):
# CONTEXTUAL_CONTENT_PROMOTION_ENABLED=1
# CONTEXTUAL_CONTENT_PROMOTION_WRITE_ENABLED=1
# CONTEXTUAL_PROMOTION_RUNTIME=supabase



