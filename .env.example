# WordRanger environment template.
# Copy to `.env.local` for `npm run dev`. Set Production values in the
# Vercel project dashboard, not in a committed file.
#
# The app only reads the names in this file. Dashboard extras such as
# Postgres URLs, JWT secret, publishable/secret keys, and
# NEXT_SUPABASE_PUBLIC_* aliases are unused.

# =============================================================================
# PRODUCTION — Vercel + Supabase
# =============================================================================
#
# Required on Vercel Production (and Preview if that environment should
# persist student progress). Missing URL + key fails closed.
#
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Server only. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
# Do not put Postgres passwords or JWT secrets in Vercel.
#
# Leave every development / Candidate flag below unset on Vercel.
# Vercel injects VERCEL and VERCEL_ENV=production|preview automatically.
# Those deployed values keep Debug tools and write gates closed.
#
# Do not set on Vercel Production:
#   RANGER_TRIAL_RUNTIME
#   GAME_RUNTIME
#   CONTEXT_LAB_ENABLED
#   CONTEXT_LAB_RUNTIME
#   CONTEXT_LAB_CONTENT_SOURCE
#   CONTEXT_LAB_E2E
#   CONTEXT_LAB_E2E_PROBE_ENABLED
#   DEBUG_TOOLS_ENABLED
#   CONTEXTUAL_CONTENT_* (all review / promotion / release flags)
#   CONTEXTUAL_PROMOTION_RUNTIME
#   CONTEXTUAL_RELEASE_RUNTIME
#   PLACEMENT_REVIEW_WRITE_ENABLED
#   PLACEMENT_REVIEW_STORE=file
#   RUN_SUPABASE_PROGRESS
#   ALLOW_SUPABASE_PROGRESS_WRITES
#
# Optional. Default is 8000ms.
# WORD_RANGER_PERSISTENCE_TIMEOUT_MS=8000
#
# Curated placement store defaults to supabase when unset. Production
# must not set PLACEMENT_REVIEW_STORE=file.
# PLACEMENT_REVIEW_STORE=supabase

# =============================================================================
# DEVELOPMENT — local `npm run dev` only
# =============================================================================
#
# Paste the same three Supabase names here if you want local durable
# adapters. `RANGER_TRIAL_RUNTIME=memory` opts student games and Daily
# Training out of Supabase; leave it unset to use the keys above.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared student-game in-memory fixture. Playwright sets this itself.
# Production must leave both unset.
# RANGER_TRIAL_RUNTIME=memory
# GAME_RUNTIME=memory

# Internal Context Lab. Default is disabled. Not a game-runtime switch.
# Homepage does not read these flags and does not show “进入场景”.
# This is not production-ready.
# CONTEXT_LAB_ENABLED=1
# CONTEXT_LAB_RUNTIME=memory
# CONTEXT_LAB_RUNTIME=supabase
# CONTEXT_LAB_CONTENT_SOURCE=static
# CONTEXT_LAB_CONTENT_SOURCE=active-release
#
# Playwright-only memory probe. Leave unset in ordinary development
# and every deployed environment. Default is 404.
# CONTEXT_LAB_E2E=1
# CONTEXT_LAB_E2E_PROBE_ENABLED=1

# Internal Debug Tools in Homepage Settings. Default is disabled.
# Production and Vercel preview stay closed even if this is set.
# DEBUG_TOOLS_ENABLED=1

# Contextual content review. Default is 404.
# CONTEXTUAL_CONTENT_REVIEW_ENABLED=1
# CONTEXTUAL_CONTENT_REVIEW_WRITE_ENABLED=1

# Contextual content batch promotion. Independent of review and release.
# CONTEXTUAL_CONTENT_PROMOTION_ENABLED=1
# CONTEXTUAL_CONTENT_PROMOTION_WRITE_ENABLED=1
# CONTEXTUAL_PROMOTION_RUNTIME=file
# CONTEXTUAL_PROMOTION_RUNTIME=memory
# CONTEXTUAL_PROMOTION_RUNTIME=supabase

# Contextual content release dry-run. Default is 404. Not publication.
# CONTEXTUAL_CONTENT_RELEASE_ENABLED=1
# CONTEXTUAL_CONTENT_RELEASE_WRITE_ENABLED=1
# CONTEXTUAL_RELEASE_RUNTIME=file
# CONTEXTUAL_RELEASE_RUNTIME=memory

# Local/internal placement-review write gate. Default is disabled.
# PLACEMENT_REVIEW_WRITE_ENABLED=1
# PLACEMENT_REVIEW_STORE=file

# Opt-in live Daily Training persistence tests. Never set on Vercel.
# ALLOW_SUPABASE_PROGRESS_WRITES=1

# Free Practice identity test factory only. Never set on Vercel.
# Public Free Practice cannot use V1_PLACEHOLDER_USER_ID. Production
# identity comes from a Supabase Auth cookie session (anon key +
# auth.getUser). Clearing the browser session loses anonymous continuity.
# WORD_RANGER_FREE_PRACTICE_TEST_IDENTITY=1
